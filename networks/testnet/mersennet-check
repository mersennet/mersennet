#!/usr/bin/env bash
# mersennet-check — one-screen health check for a Mersennet full node.
# Installed by install.sh; safe to run as any user (reads only).
set -u

LOCAL_RPC="${MERSENNET_RPC:-http://127.0.0.1:8545}"
PUBLIC_RPC="https://rpc.mersennet.com"

rpc() { # rpc URL METHOD [PARAMS_JSON]
    curl -s --max-time 6 "$1" -H 'Content-Type: application/json' \
        -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$2\",\"params\":${3:-[]}}" 2>/dev/null \
        | sed -n 's/.*"result":"\([^"]*\)".*/\1/p'
}
hex2dec() { [[ -n "${1:-}" ]] && printf '%d' "$1" 2>/dev/null || echo ""; }
green() { printf '\033[32m%s\033[0m' "$1"; }
red()   { printf '\033[31m%s\033[0m' "$1"; }
yellow(){ printf '\033[33m%s\033[0m' "$1"; }

echo "Mersennet node check — $(date -u '+%Y-%m-%d %H:%M UTC')"
echo

# Service
if command -v systemctl >/dev/null 2>&1; then
    state="$(systemctl is-active mersennet 2>/dev/null || true)"
    since="$(systemctl show mersennet -p ActiveEnterTimestamp --value 2>/dev/null | cut -d' ' -f2-3)"
    datadir="$(systemctl show mersennet -p WorkingDirectory --value 2>/dev/null)"
    case "$state" in
        active)   printf 'Service      %s since %s\n' "$(green running)" "${since:-?}" ;;
        "")       printf 'Service      %s\n' "$(yellow 'not installed as a service (mersennet.service missing)')" ;;
        *)        printf 'Service      %s (%s)\n' "$(red "$state")" "systemctl status mersennet" ;;
    esac
    # A restored state that does not match the chain: the node logs it (and
    # from engine.resume_root_check=fatal refuses to run). The fix is always
    # the same.
    if journalctl -u mersennet --since '-10min' --no-pager 2>/dev/null | grep -q 'RESTORED STATE ROOT MISMATCH'; then
        printf 'State        %s — this node'"'"'s state does not match the chain. Fix: re-run the installer with --reset-state (keeps keys; restores the latest snapshot, ~1 min)\n' "$(red 'does not match the chain')"
    fi
    # Self-restarts: the node exits when its head stops while the network
    # moves on (or its engine lock is stuck) and systemd brings it back.
    restarts="$(systemctl show mersennet -p NRestarts --value 2>/dev/null)"
    if [[ "${restarts:-0}" -gt 0 ]]; then
        last_wd="$(journalctl -u mersennet --no-pager -o short-iso 2>/dev/null | grep -E 'head has not advanced|engine lock unobtainable' | tail -1 | cut -d' ' -f1)"
        printf 'Restarts     %s since boot%s — normal once in a while; if it repeats, send journalctl -u mersennet -n 300 via https://trade.mersennet.com/feedback\n' "$(yellow "$restarts")" "${last_wd:+ (last watchdog event $last_wd)}"
    fi
fi

# Heights
local_hex="$(rpc "$LOCAL_RPC" eth_blockNumber)"
public_hex="$(rpc "$PUBLIC_RPC" eth_blockNumber)"
local_h="$(hex2dec "$local_hex")"
public_h="$(hex2dec "$public_hex")"
if [[ -z "$local_h" ]]; then
    printf 'Local RPC    %s at %s\n' "$(red 'not answering')" "$LOCAL_RPC"
    echo "             The node may still be starting (first start replays the chain), or RPC is disabled."
    echo "             Logs: journalctl -u mersennet -n 30 --no-pager"
else
    if [[ -z "$public_h" ]]; then
        printf 'Block height %s (network height unavailable — no internet or rpc.mersennet.com unreachable)\n' "$local_h"
    else
        lag=$(( public_h - local_h ))
        if (( lag <= 3 )); then
            printf 'Block height %s / %s network — %s\n' "$local_h" "$public_h" "$(green 'in sync')"
        elif (( lag <= 2000 )); then
            printf 'Block height %s / %s network — %s (%s blocks behind)\n' "$local_h" "$public_h" "$(yellow 'catching up')" "$lag"
        else
            pct=$(( local_h * 100 / (public_h > 0 ? public_h : 1) ))
            # Measure the sync rate over a few seconds for an ETA.
            sleep 4
            later_h="$(hex2dec "$(rpc "$LOCAL_RPC" eth_blockNumber)")"
            eta=""
            if [[ -n "$later_h" ]] && (( later_h > local_h )); then
                rate=$(( (later_h - local_h) / 4 ))
                if (( rate > 0 )); then
                    secs=$(( lag / rate ))
                    if (( secs < 90 )); then eta="~1 min left"; elif (( secs < 5400 )); then eta="~$(( (secs + 59) / 60 )) min left"; else eta="~$(( (secs + 1799) / 3600 )) h left"; fi
                    eta=", $rate blocks/s, $eta"
                fi
            elif [[ -n "$later_h" ]]; then
                eta=", $(red 'not advancing') — check journalctl -u mersennet -n 30"
            fi
            printf 'Block height %s / %s network — %s (%s%% done%s)\n' "$later_h" "$public_h" "$(yellow syncing)" "$pct" "$eta"
        fi
    fi
    peers_hex="$(rpc "$LOCAL_RPC" net_peerCount)"
    peers="$(hex2dec "$peers_hex")"
    if [[ -n "$peers" ]]; then
        if (( peers > 0 )); then printf 'Peers        %s (P2P connections: validators, public RPC nodes and other full nodes — not the validator count)\n' "$(green "$peers")"; else printf 'Peers        %s (P2P not connected yet — outbound UDP+TCP 30303 must be allowed)\n' "$(red 0)"; fi
    fi
    chain_hex="$(rpc "$LOCAL_RPC" eth_chainId)"
    chain="$(hex2dec "$chain_hex")"
    [[ -n "$chain" ]] && printf 'Chain ID     %s%s\n' "$chain" "$([[ "$chain" == "131071" ]] && echo ' (Mersennet testnet)' || red '  <-- expected 131071')"
fi

# Visibility: does the public RPC node currently hear from this machine?
pub_ip="$(curl -s --max-time 4 https://api.ipify.org 2>/dev/null || curl -s --max-time 4 https://ifconfig.me/ip 2>/dev/null || true)"
if [[ "$pub_ip" =~ ^[0-9a-fA-F.:]+$ ]]; then
    node_id="$(printf '%s' "$pub_ip" | sha256sum | cut -c1-6)"
    peers_json="$(curl -s --max-time 6 "$PUBLIC_RPC" -H 'Content-Type: application/json' \
        -d '{"jsonrpc":"2.0","id":1,"method":"mersennet_peers","params":[]}' 2>/dev/null || true)"
    if [[ -z "$peers_json" ]]; then
        printf 'Visibility   could not query the public node (id %s)\n' "$node_id"
    elif printf '%s' "$peers_json" | grep -q "\"addr\":\"$pub_ip:[0-9]*\",\"firstSeenSecs\":[0-9]*,\"heard\":true"; then
        printf 'Visibility   %s — the network hears this node as %s · id %s (explorer → Network → Network nodes)\n' "$(green 'visible')" "$pub_ip" "$node_id"
        # Inbound TCP 30303: needed for verification, points and validator
        # registration (the network probes the node). Ask the API to try.
        probe=$(curl -s --max-time 12 "https://trade.mersennet.com/api/v1/nodes/probe?host=$pub_ip" 2>/dev/null | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin); print('open' if d.get('reachable') else ('blocked:'+str(d.get('error',''))[:80]))
except Exception:
    print('?')" 2>/dev/null)
        case "$probe" in
            open)     printf 'Reachable    %s — tcp/30303 answers from the internet (verification and registration work)\n' "$(green 'yes')" ;;
            blocked:*) printf 'Reachable    %s — tcp/30303 is not reachable from the internet (%s). Allow 30303 tcp+udp in your provider firewall; until then the node cannot be verified.\n' "$(red 'no')" "${probe#blocked:}" ;;
            *)        printf 'Reachable    could not probe right now (trade.mersennet.com unreachable)\n' ;;
        esac
    else
        printf 'Visibility   %s — the public node has not heard from %s yet (id %s). Normal for the first minute; if it persists, allow outbound UDP 30303.\n' "$(yellow 'not yet seen')" "$pub_ip" "$node_id"
    fi
fi

# Node identity (block-signing address) — what you register as a validator
ident=$(curl -s --max-time 3 http://127.0.0.1:8545 -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"mersennet_nodeIdentity","params":[]}' 2>/dev/null | sed -n 's/.*"identity":"\(0x[0-9a-f]*\)".*/\1/p')

# Operator wallet (verified node runner). Verification is automatic: the
# network probes visible nodes every few minutes and records the operator
# the node signs for; ask the public list whether this identity is in it.
operator=$(python3 -c "import json; print(json.load(open('/etc/mersennet/config.json')).get('p2p',{}).get('operator_address') or '')" 2>/dev/null)
if [[ -n "$operator" ]]; then
    vstate=$(curl -s --max-time 5 https://trade.mersennet.com/api/v1/nodes/verified 2>/dev/null | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    n=next((n for n in d.get('nodes',[]) if (n.get('identity') or '').lower()=='${ident}'.lower()), None)
    print('active' if n and n.get('active') else ('stale' if n else 'none'))
except Exception:
    print('?')" 2>/dev/null)
    case "$vstate" in
        active) printf 'Operator     %s — %s, earning %s at https://trade.mersennet.com/points\n' "$operator" "$(green 'verified node runner')" "$(green '500 points/day')" ;;
        stale)  printf 'Operator     %s — verified, but not seen recently; check Visibility above (inbound 30303 tcp+udp)\n' "$operator" ;;
        none)   printf 'Operator     %s — %s: automatic within ~10 minutes once the node is visible; nothing to do\n' "$operator" "$(yellow 'not verified yet')" ;;
        *)      printf 'Operator     %s — verification status unavailable right now (trade.mersennet.com unreachable)\n' "$operator" ;;
    esac
else
    printf 'Operator     %s — set one to be recognised as a node runner: re-run the installer with --operator 0xYOURWALLET (or add p2p.operator_address to /etc/mersennet/config.json and restart)\n' "$(yellow 'not set')"
fi

if [[ -n "$ident" ]]; then
    vset=$(curl -s --max-time 4 http://127.0.0.1:8545 -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"mersennet_validatorSet","params":[]}' 2>/dev/null)
    if echo "$vset" | grep -q "\"identity\":\"$ident\""; then
        vinfo=$(echo "$vset" | python3 -c "
import json,sys
d=json.load(sys.stdin)['result']
v=next((v for v in d['validators'] if v['identity']=='$ident'),None)
if v:
    blocks_left=max(0,d['nextEpochAt']-d['height'])
    print(f\"{v['status']}|{v['proposedSlots']}|{v['missedSlots']}|{d['epoch']}|{blocks_left}|{int(v['selfStake'],16)//10**18}\")" 2>/dev/null)
        IFS='|' read -r st prop miss ep left selfst <<< "$vinfo"
        case "$st" in
            active)  printf 'Validator    %s — %s · self-stake %s MRSN · epoch %s: %s blocks proposed, %s missed\n' "$ident" "$(green 'active')" "$selfst" "$ep" "$prop" "$miss" ;;
            pending) printf 'Validator    %s — %s · joins the active set in %s blocks (~%s min)\n' "$ident" "$(yellow 'pending')" "$left" "$(( left * 2 / 60 ))" ;;
            jailed)  printf 'Validator    %s — %s for this epoch (missed too many slots last epoch); back automatically in %s blocks\n' "$ident" "$(red 'jailed')" "$left" ;;
            *)       printf 'Validator    %s — registered, status %s (epoch %s)\n' "$ident" "$(yellow "$st")" "$ep" ;;
        esac
    elif echo "$vset" | grep -q '"active":true'; then
        printf 'Validator    %s — not registered; bond 1,000 MRSN at https://trade.mersennet.com/staking to start producing blocks\n' "$ident"
    else
        act=$(echo "$vset" | sed -n 's/.*"activationHeight":\([0-9]*\).*/\1/p')
        printf 'Validator    %s — registration opens at block %s (https://trade.mersennet.com/staking)\n' "$ident" "${act:-?}"
    fi
fi

# Binary version vs the latest published release
if [[ -x /usr/local/bin/mersennet ]] && command -v sha256sum >/dev/null; then
    have="$(sha256sum /usr/local/bin/mersennet | cut -d' ' -f1)"
    latest_json="$(curl -s --max-time 6 "https://mersennet.com/downloads/latest.json" 2>/dev/null || true)"
    want="$(printf '%s' "$latest_json" | sed -n 's/.*"binary_sha256": *"\([0-9a-f]*\)".*/\1/p')"
    rel="$(printf '%s' "$latest_json" | sed -n 's/.*"release": *"\([^"]*\)".*/\1/p')"
    if [[ -z "$want" ]]; then
        printf 'Binary       %s (could not check for updates)\n' "${have:0:12}"
    elif [[ "$have" == "$want" ]]; then
        printf 'Binary       %s — %s (release %s)\n' "${have:0:12}" "$(green 'up to date')" "${rel:-?}"
    else
        printf 'Binary       %s — %s: release %s is out. Upgrade: curl -fsSL https://mersennet.com/downloads/install.sh | sudo bash\n' "${have:0:12}" "$(yellow 'update available')" "${rel:-?}"
        # Consensus switch heights come from the network's parameters (the
        # public node runs the current release, so it knows all of them).
        if [[ -n "${public_h:-}" ]]; then
            pvset=$(curl -s --max-time 4 "$PUBLIC_RPC" -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"mersennet_validatorSet","params":[]}' 2>/dev/null)
            next_switch=$(printf '%s' "$pvset" | python3 -c '
import json, sys
try:
    p = json.load(sys.stdin)["result"]["params"]; head = int(sys.argv[1])
    hs = [int(p.get(k) or 0) for k in ("rewardsToOperatorHeight", "jailEscalationHeight", "benchHeight")]
    hs = [h for h in hs if h > head]
    print(min(hs) if hs else "")
except Exception:
    print("")' "$public_h" 2>/dev/null)
            if [[ -n "$next_switch" ]]; then
                hours=$(( (next_switch - public_h) * 2 / 3600 ))
                printf '             %s: a protocol switch is scheduled at block %s (~%s h). A validator on an old build forks off there; a full node stops following.\n' "$(yellow 'Upgrade before the switch')" "$next_switch" "$hours"
            fi
        fi
    fi
fi

# Disk
if [[ -n "${datadir:-}" && -d "$datadir" ]]; then
    used="$(du -sh "$datadir" 2>/dev/null | cut -f1)"
    free="$(df -h "$datadir" 2>/dev/null | awk 'NR==2{print $4" free on "$6}')"
    printf 'Data dir     %s — %s used, %s\n' "$datadir" "${used:-?}" "${free:-?}"
    if [[ -f "$datadir/keys/node_key.json" ]]; then
        printf 'Node key     %s (back this up to keep your peer identity)\n' "$datadir/keys/node_key.json"
    fi
fi

echo
echo "Explorer: https://explorer.mersennet.com   Docs: https://docs.mersennet.com/validators/run-a-node/   Chat: https://t.me/Mersennet"
echo "Full node and validator in one: the node proposes and votes whenever its identity is in the active set (see the Validator line)."
