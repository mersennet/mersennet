#!/usr/bin/env bash
# mersennet-check — one-screen health check for a Mersennet full node.
# Installed by install.sh; safe to run as any user (reads only).
set -u

LOCAL_RPC="${MERSENNET_RPC:-http://127.0.0.1:8545}"
PUBLIC_RPC="https://rpc.mersennet.com"

rpc() { # rpc URL METHOD [PARAMS_JSON]
    curl -s --max-time 6 "$1" -H 'Content-Type: application/json' \
        -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$2\",\"params\":${3:-[]}}" 2>/dev/null \
        | sed -n 's/.*"result":"\([^"]*\)".*/\1/p'
}
hex2dec() { [[ -n "${1:-}" ]] && printf '%d' "$1" 2>/dev/null || echo ""; }
green() { printf '\033[32m%s\033[0m' "$1"; }
red()   { printf '\033[31m%s\033[0m' "$1"; }
yellow(){ printf '\033[33m%s\033[0m' "$1"; }

echo "Mersennet node check — $(date -u '+%Y-%m-%d %H:%M UTC')"
echo

# Service
if command -v systemctl >/dev/null 2>&1; then
    state="$(systemctl is-active mersennet 2>/dev/null || true)"
    since="$(systemctl show mersennet -p ActiveEnterTimestamp --value 2>/dev/null | cut -d' ' -f2-3)"
    datadir="$(systemctl show mersennet -p WorkingDirectory --value 2>/dev/null)"
    case "$state" in
        active)   printf 'Service      %s since %s\n' "$(green running)" "${since:-?}" ;;
        "")       printf 'Service      %s\n' "$(yellow 'not installed as a service (mersennet.service missing)')" ;;
        *)        printf 'Service      %s (%s)\n' "$(red "$state")" "systemctl status mersennet" ;;
    esac
fi

# Heights
local_hex="$(rpc "$LOCAL_RPC" eth_blockNumber)"
public_hex="$(rpc "$PUBLIC_RPC" eth_blockNumber)"
local_h="$(hex2dec "$local_hex")"
public_h="$(hex2dec "$public_hex")"
if [[ -z "$local_h" ]]; then
    printf 'Local RPC    %s at %s\n' "$(red 'not answering')" "$LOCAL_RPC"
    echo "             The node may still be starting (first start replays the chain), or RPC is disabled."
    echo "             Logs: journalctl -u mersennet -n 30 --no-pager"
else
    if [[ -z "$public_h" ]]; then
        printf 'Block height %s (network height unavailable — no internet or rpc.mersennet.com unreachable)\n' "$local_h"
    else
        lag=$(( public_h - local_h ))
        if (( lag <= 3 )); then
            printf 'Block height %s / %s network — %s\n' "$local_h" "$public_h" "$(green 'in sync')"
        elif (( lag <= 2000 )); then
            printf 'Block height %s / %s network — %s (%s blocks behind)\n' "$local_h" "$public_h" "$(yellow 'catching up')" "$lag"
        else
            pct=$(( local_h * 100 / (public_h > 0 ? public_h : 1) ))
            # Measure the sync rate over a few seconds for an ETA.
            sleep 4
            later_h="$(hex2dec "$(rpc "$LOCAL_RPC" eth_blockNumber)")"
            eta=""
            if [[ -n "$later_h" ]] && (( later_h > local_h )); then
                rate=$(( (later_h - local_h) / 4 ))
                if (( rate > 0 )); then
                    secs=$(( lag / rate ))
                    if (( secs < 90 )); then eta="~1 min left"; elif (( secs < 5400 )); then eta="~$(( (secs + 59) / 60 )) min left"; else eta="~$(( (secs + 1799) / 3600 )) h left"; fi
                    eta=", $rate blocks/s, $eta"
                fi
            elif [[ -n "$later_h" ]]; then
                eta=", $(red 'not advancing') — check journalctl -u mersennet -n 30"
            fi
            printf 'Block height %s / %s network — %s (%s%% done%s)\n' "$later_h" "$public_h" "$(yellow syncing)" "$pct" "$eta"
        fi
    fi
    peers_hex="$(rpc "$LOCAL_RPC" net_peerCount)"
    peers="$(hex2dec "$peers_hex")"
    if [[ -n "$peers" ]]; then
        if (( peers > 0 )); then printf 'Peers        %s\n' "$(green "$peers")"; else printf 'Peers        %s (P2P not connected yet — outbound UDP+TCP 30303 must be allowed)\n' "$(red 0)"; fi
    fi
    chain_hex="$(rpc "$LOCAL_RPC" eth_chainId)"
    chain="$(hex2dec "$chain_hex")"
    [[ -n "$chain" ]] && printf 'Chain ID     %s%s\n' "$chain" "$([[ "$chain" == "131071" ]] && echo ' (Mersennet testnet)' || red '  <-- expected 131071')"
fi

# Visibility: does the public RPC node currently hear from this machine?
pub_ip="$(curl -s --max-time 4 https://api.ipify.org 2>/dev/null || curl -s --max-time 4 https://ifconfig.me/ip 2>/dev/null || true)"
if [[ "$pub_ip" =~ ^[0-9a-fA-F.:]+$ ]]; then
    node_id="$(printf '%s' "$pub_ip" | sha256sum | cut -c1-6)"
    peers_json="$(curl -s --max-time 6 "$PUBLIC_RPC" -H 'Content-Type: application/json' \
        -d '{"jsonrpc":"2.0","id":1,"method":"mersennet_peers","params":[]}' 2>/dev/null || true)"
    if [[ -z "$peers_json" ]]; then
        printf 'Visibility   could not query the public node (id %s)\n' "$node_id"
    elif printf '%s' "$peers_json" | grep -q "\"addr\":\"$pub_ip:[0-9]*\",\"firstSeenSecs\":[0-9]*,\"heard\":true"; then
        printf 'Visibility   %s — the network hears this node as %s · id %s (explorer → Network → Network nodes)\n' "$(green 'visible')" "$pub_ip" "$node_id"
    else
        printf 'Visibility   %s — the public node has not heard from %s yet (id %s). Normal for the first minute; if it persists, allow outbound UDP 30303.\n' "$(yellow 'not yet seen')" "$pub_ip" "$node_id"
    fi
fi

# Operator wallet (verified node runner)
operator=$(python3 -c "import json; print(json.load(open('/etc/mersennet/config.json')).get('p2p',{}).get('operator_address') or '')" 2>/dev/null)
if [[ -n "$operator" ]]; then
    printf 'Operator     %s — verify this node at https://trade.mersennet.com/points to earn daily points\n' "$operator"
else
    printf 'Operator     %s — set one to be recognised as a node runner: re-run the installer with --operator 0xYOURWALLET (or add p2p.operator_address to /etc/mersennet/config.json and restart)\n' "$(yellow 'not set')"
fi

# Binary version vs the latest published release
if [[ -x /usr/local/bin/mersennet ]] && command -v sha256sum >/dev/null; then
    have="$(sha256sum /usr/local/bin/mersennet | cut -d' ' -f1)"
    latest_json="$(curl -s --max-time 6 "https://mersennet.com/downloads/latest.json" 2>/dev/null || true)"
    want="$(printf '%s' "$latest_json" | sed -n 's/.*"binary_sha256": *"\([0-9a-f]*\)".*/\1/p')"
    rel="$(printf '%s' "$latest_json" | sed -n 's/.*"release": *"\([^"]*\)".*/\1/p')"
    if [[ -z "$want" ]]; then
        printf 'Binary       %s (could not check for updates)\n' "${have:0:12}"
    elif [[ "$have" == "$want" ]]; then
        printf 'Binary       %s — %s (release %s)\n' "${have:0:12}" "$(green 'up to date')" "${rel:-?}"
    else
        printf 'Binary       %s — %s: release %s is out. Upgrade: curl -fsSL https://mersennet.com/downloads/install.sh | sudo bash\n' "${have:0:12}" "$(yellow 'update available')" "${rel:-?}"
    fi
fi

# Disk
if [[ -n "${datadir:-}" && -d "$datadir" ]]; then
    used="$(du -sh "$datadir" 2>/dev/null | cut -f1)"
    free="$(df -h "$datadir" 2>/dev/null | awk 'NR==2{print $4" free on "$6}')"
    printf 'Data dir     %s — %s used, %s\n' "$datadir" "${used:-?}" "${free:-?}"
    if [[ -f "$datadir/keys/node_key.json" ]]; then
        printf 'Node key     %s (back this up to keep your peer identity)\n' "$datadir/keys/node_key.json"
    fi
fi

echo
echo "Explorer: https://explorer.mersennet.com   Docs: https://docs.mersennet.com/validators/run-a-node/"
echo "This is a full node. The validator set is fixed at genesis for now, so it will not appear in the validator list."
