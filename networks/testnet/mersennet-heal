#!/usr/bin/env bash
# mersennet-heal — restore this node's chain state when the node itself asks for
# it: the node exits with code 6 when it is on a branch it can no longer roll
# back (the network finalized another block below its rollback window). The
# unit does not restart it into the same state (RestartPreventExitStatus=6);
# systemd starts mersennet-heal.service instead (OnFailure=), which runs this.
#
#   mersennet-heal [DATA_DIR]      # default /var/lib/mersennet
#
# Only acts when the node's last exit status really is 6: a crash loop or a
# config error also fails the unit, and must never cost the chain state.
# Keys, node identity and voter_last_voted (outside data/state) are kept.
#
# MERSENNET_HEAL_MODE=snapshot (default): download the latest published
#   snapshot, check its SHA-256 against the manifest, then replace data/state.
#   The old state goes only after the download verified (small disks cannot
#   hold both the old state and the unpacked snapshot).
# MERSENNET_HEAL_MODE=resync: discard data/state and sync from genesis (a
#   chain without a snapshot server, such as the closed privacy testnet).
set -euo pipefail
DATA_DIR="${1:-/var/lib/mersennet}"
DATA_DIR="${DATA_DIR%/}"
SERVICE="${MERSENNET_SERVICE:-mersennet}"
MODE="${MERSENNET_HEAL_MODE:-snapshot}"
MANIFEST="${MERSENNET_SNAPSHOT_MANIFEST:-http://46.225.30.187:8088/latest.json}"
STATE="$DATA_DIR/data/state"
log() { echo "mersennet-heal: $*"; }
start_node() { systemctl reset-failed "$SERVICE" 2>/dev/null || true; systemctl start "$SERVICE"; }

status="$(systemctl show -p ExecMainStatus --value "$SERVICE" 2>/dev/null || echo "")"
if [[ "$status" != 6 ]]; then
    log "the node's last exit status is '${status:-none}', not 6 (fork beyond recovery): nothing to heal"
    exit 0
fi
if systemctl is-active --quiet "$SERVICE"; then
    log "$SERVICE is running again: nothing to heal"
    exit 0
fi
[[ -d "$STATE" ]] || { log "no chain state at $STATE"; start_node; exit 0; }

owner="$(stat -c %U:%G "$DATA_DIR" 2>/dev/null || echo mersennet:mersennet)"
case "$MODE" in
resync)
    log "discarding $STATE; the node syncs again from genesis"
    rm -rf "$STATE"
    ;;
snapshot)
    tmp="$(mktemp -d "$DATA_DIR/.heal.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL --max-time 30 -o "$tmp/latest.json" "$MANIFEST" \
        || { log "snapshot manifest unreachable ($MANIFEST): starting the node as it is, it will ask again"; start_node; exit 1; }
    url=$(sed -n 's/.*"url": *"\([^"]*\)".*/\1/p' "$tmp/latest.json")
    sha=$(sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p' "$tmp/latest.json")
    height=$(sed -n 's/.*"height": *\([0-9]*\).*/\1/p' "$tmp/latest.json")
    [[ -n "$url" && -n "$sha" ]] || { log "manifest unreadable"; start_node; exit 1; }
    log "downloading the snapshot at height ${height:-?}"
    if ! curl -fsSL --retry 3 -o "$tmp/state.tar.zst" "$url" \
        || ! echo "$sha  $tmp/state.tar.zst" | sha256sum -c --quiet -; then
        log "download or checksum failed: starting the node as it is, it will ask again"
        start_node
        exit 1
    fi
    command -v zstd >/dev/null 2>&1 || apt-get install -y -qq zstd >/dev/null 2>&1 || true
    log "checksum ok; replacing $STATE"
    rm -rf "$STATE"
    mkdir -p "$STATE"
    if ! zstd -dc "$tmp/state.tar.zst" | tar -xf - -C "$STATE"; then
        log "extraction failed: the node starts from genesis instead"
        rm -rf "$STATE"
    fi
    rm -f "$STATE/SNAPSHOT_INFO"
    ;;
*)
    log "unknown MERSENNET_HEAL_MODE '$MODE'"
    start_node
    exit 1
    ;;
esac
chown -R "$owner" "$DATA_DIR/data" 2>/dev/null || true
log "state healed; starting $SERVICE"
start_node
