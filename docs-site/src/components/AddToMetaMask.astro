---
// One-click "Add Mersennet to MetaMask" button. Vanilla island — no framework.
---

<button class="add-metamask" data-add-mersennet>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M2 12h20"/></svg>
  Add Mersennet to MetaMask
</button>
<span class="add-metamask-status" data-add-mersennet-status role="status"></span>

<script>
  const PARAMS = {
    chainId: '0x1eef', // 7919
    chainName: 'Mersennet Testnet',
    nativeCurrency: { name: 'PRIM', symbol: 'PRIM', decimals: 18 },
    rpcUrls: ['http://46.225.30.187:8545'],
    blockExplorerUrls: ['http://46.225.30.187'],
  };
  document.querySelectorAll('[data-add-mersennet]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const status = document.querySelector('[data-add-mersennet-status]');
      const eth = (window as any).ethereum;
      if (!eth) {
        if (status) status.textContent = 'MetaMask not detected — install it first.';
        return;
      }
      try {
        await eth.request({ method: 'wallet_addEthereumChain', params: [PARAMS] });
        if (status) status.textContent = 'Mersennet added ✓';
      } catch (err: any) {
        if (status) status.textContent = err?.message ?? 'Request rejected.';
      }
    });
  });
</script>

<style>
  .add-metamask {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .add-metamask:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
  }
  .add-metamask-status {
    margin-left: 0.8rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
</style>
