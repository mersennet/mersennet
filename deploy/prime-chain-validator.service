[Unit]
Description=Mersennet Validator Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=primechain
Group=primechain
ExecStart=/opt/prime-chain/bin/prime-chain \
    --config /opt/prime-chain/config/config.json \
    --validator \
    --rpc
Restart=always
RestartSec=5
LimitNOFILE=65535
Environment=RUST_LOG=info
WorkingDirectory=/opt/prime-chain/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prime-chain

[Install]
WantedBy=multi-user.target
